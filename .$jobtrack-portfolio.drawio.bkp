    <mxCell id="api_arch" value="Layered Architecture: Controller → Service → Repository → MongoDB&#xa;Ownership checks in every Service (entity.UserId != requestUserId)&#xa;FluentValidation on all incoming DTOs  |  Async/await throughout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=10;align=left;" vertex="1" parent="api_c">
      <mxGeometry x="10" y="275" width="395" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="api_cache" value="IMemoryCache:  Per-user in-process cache on JobApplications, Activities, Recruiters&#xa;TTL: 5 min absolute / 2 min sliding  ·  Automatically invalidated on every mutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="api_c">
      <mxGeometry x="10" y="340" width="395" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="api_infra" value="Health check: GET /health → MongoDB probe (3s timeout)&#xa;OpenAPI / Swagger  |  BCrypt password hashing  |  MongoDB compound indexes on startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=10;align=left;" vertex="1" parent="api_c">
      <mxGeometry x="10" y="395" width="395" height="45" as="geometry"/>
