# JobTrack root environment
# Copy this file to `.env` before using docker-compose.
# Do not commit `.env`.

# JWT signing key for the API.
# Generate a long random value.
# PowerShell:
#   [Convert]::ToBase64String((1..64 | %{ Get-Random -Max 256 } | %{ [byte]$_ }))
# Bash:
#   openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret

# Supabase Storage. The API expects a bucket named `documents`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key

# Password reset email.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=JobTrack

# Used when building password reset links.
APP_BASE_URL=http://localhost:5173
